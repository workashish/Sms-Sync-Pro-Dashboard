SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe Supabase publishable key (sb_publishable_...) or legacy anon key.
SUPABASE_PUBLISHABLE_KEY=
# Legacy project JWT secret used only on the server to mint five-minute read-only Realtime tokens.
SUPABASE_JWT_SECRET=
DASHBOARD_PASSWORD=
APP_HMAC_SECRET=
# Optional. Must match the Android AES password exactly.
APP_AES_PASSWORD=

# Optional separate random session secret; password is used when unset.
DASHBOARD_SESSION_SECRET=
# Enable only behind a proxy that overwrites X-Forwarded-For. Vercel is detected automatically.
AUTH_TRUST_PROXY=false

# Set to the public HTTPS origin if your reverse proxy rewrites Host.
DASHBOARD_ORIGIN=
